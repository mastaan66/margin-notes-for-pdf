{
  "name": "margin-notes-for-pdf",
  "version": "1.3.0",
  "description": "Browser extension: notes beside PDFs (per page), web pages (per section) and videos (per timestamp)",
  "main": "index.js",
  "scripts": {
    "test": "node test/e2e.mjs",
    "test:intercept": "node test/e2e-intercept.mjs",
    "test:web": "node test/e2e-web.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "pack": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "lint:firefox": "npx web-ext lint --source-dir build/firefox",
    "run:firefox": "npx web-ext run --source-dir build/firefox",
    "test:firefox": "node test/e2e-firefox.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "puppeteer-core": "^25.7.0"
  },
