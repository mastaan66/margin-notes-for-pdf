{
  "manifest_version": 3,
  "name": "Margin Notes for PDF",
  "short_name": "Margin Notes",
  "version": "1.3.0",
  "description": "Dock PDFs, web pages, HTML, text and images to one side and take per-page (or per-section) notes and handwriting in the free space.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "webNavigation",
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Margin Notes for PDF",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "side_panel": { "default_path": "viewer/panel.html" },
  "web_accessible_resources": [
    { "resources": ["viewer/viewer.html"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" } }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
